{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": ".build/client",
    "rootDir": "src/client",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true
  },
  "include": ["src/client/**/*.ts"]
}
